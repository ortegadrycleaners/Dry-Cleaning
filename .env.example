# =============================================================================
# Configuración del cliente (frontend) para el envío de SMS vía Twilio.
#
# El bundle del frontend NUNCA debe contener Account SID ni Auth Token de
# Twilio. Esas credenciales viven en el backend (Supabase Edge Function o
# API propia). Aquí solo configuramos:
#   - URL del endpoint backend que dispara Twilio.
#   - Cuotas locales de defensa en profundidad.
#   - Flags de modo mock / kill switch / allowlist.
#
# Ver: docs/TWILIO_SETUP.md
# =============================================================================

# URL del endpoint backend que dispara Twilio (POST JSON).
# Ejemplo Supabase Edge Function:
#   https://<project>.functions.supabase.co/notify-order-ready
# Si está vacía, el frontend trabaja en MODO MOCK (no envía nada).
VITE_NOTIFY_ENDPOINT_URL=

# (Opcional) API key pública que el endpoint valida. Bearer token.
# NO usar el Auth Token de Twilio aquí.
VITE_NOTIFY_ENDPOINT_KEY=

# Forzar modo mock incluso con URL configurada (útil en staging / pruebas).
VITE_TWILIO_MOCK=true

# Presupuesto diario máximo de SMS (kill switch automático al alcanzarlo).
VITE_SMS_DAILY_BUDGET=200

# Horas mínimas entre dos SMS para una misma orden.
VITE_SMS_PER_ORDER_HOURS=24

# Máximo de SMS por minuto en TODO el sistema.
VITE_SMS_GLOBAL_PER_MINUTE=30

# Cooldown anti doble-click entre dos sends consecutivos (ms).
VITE_SMS_COOLDOWN_MS=5000

# CSV de teléfonos en E.164 permitidos (modo allowlist para QA).
# Vacío = sin allowlist (modo producción).
# Ejemplo: VITE_SMS_ALLOWLIST=+17875550101,+17875550182
VITE_SMS_ALLOWLIST=

# Kill switch global. true => bloquea TODOS los envíos.
# Útil ante incidente de costos. También puede activarse en runtime desde
# el panel admin (setKillSwitchOverride) sin redeploy.
VITE_SMS_KILL_SWITCH=false
