# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SMS via Edge Function send-reminder-sms (set false for real sends)
VITE_TWILIO_MOCK=true

# Optional: legacy HTTP endpoint override (default: supabase.functions.invoke)
# VITE_NOTIFY_ENDPOINT_URL=
# VITE_NOTIFY_ENDPOINT_KEY=

# Client-side SMS guards (defense in depth; server enforces via secrets)
VITE_SMS_DAILY_BUDGET=200
VITE_SMS_PER_ORDER_HOURS=24
VITE_SMS_GLOBAL_PER_MINUTE=30
VITE_SMS_COOLDOWN_MS=5000
# VITE_SMS_ALLOWLIST=+17875550101,+12025551234
VITE_SMS_KILL_SWITCH=false

# Edge Function secrets (set via: supabase secrets set ...)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1XXXXXXXXXX
# SMS_KILL_SWITCH=false
# SMS_DAILY_BUDGET=200
# SMS_GLOBAL_PER_MINUTE=30
# SMS_ALLOWLIST=
# PUBLIC_APP_URL=https://your-domain.com
# BRAND_NAME=Ortega Dry Cleaners
# STORE_PHONE=(904) 666-0809
